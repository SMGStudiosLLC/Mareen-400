// metal_stdlib, CPU edition.
//
// A small compatibility layer that lets clang compile and run the Metal Shading
// Language source embedded in MarennFilter.swift on an ordinary CPU. It exists so
// the shipped shader can be rendered, tested and diffed on machines without Metal
// (Linux, CI). It implements only the subset of MSL the filter uses.
//
// Vectors are clang ext_vector_type, so swizzles such as .rgb and .xy are native.
// Constructor calls like float3(a, b) and unsuffixed float literals are rewritten
// by msl2cpp.py before compilation, see that file for details.
#pragma once
#include <cmath>
#include <cstdint>
#include <cstring>
#include <type_traits>
#include <vector>

